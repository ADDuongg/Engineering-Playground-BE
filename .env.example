# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Platform Database (users, progress, quiz - permanent)
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform_secret
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_POOL_SIZE=10

# Playground Database (experiment datasets - resettable)
PLAYGROUND_DB_HOST=localhost
PLAYGROUND_DB_PORT=5433
PLAYGROUND_DB_USER=playground
PLAYGROUND_DB_PASSWORD=playground_secret
PLAYGROUND_DB_NAME=playground_db
PLAYGROUND_DB_POOL_SIZE=5

# Redis (cache, queues - future BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_DAYS=7
