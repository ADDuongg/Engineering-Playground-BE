# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Platform Database (users, progress, quiz - permanent)
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5434
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform_secret
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_POOL_SIZE=10

# Playground Database (experiment datasets - resettable)
PLAYGROUND_DB_HOST=localhost
PLAYGROUND_DB_PORT=5433
PLAYGROUND_DB_USER=playground
PLAYGROUND_DB_PASSWORD=playground_secret
PLAYGROUND_DB_NAME=playground_db
PLAYGROUND_DB_POOL_SIZE=5

# Redis (cache, rate limits, BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Worker Queue Foundation (shared job status + per-type queues)
# See specs/012-worker-queue-foundation/quickstart.md
JOB_STATUS_TTL_SECONDS=86400

DATASET_RESET_QUEUE_NAME=dataset-reset-jobs
DATASET_RESET_WORKER_CONCURRENCY=2
DATASET_RESET_JOB_TIMEOUT_SECONDS=600
DATASET_RESET_MAX_ATTEMPTS=3
DATASET_RESET_BACKOFF_DELAY_MS=2000

# Benchmark Runner (BullMQ + k6 worker — see specs/011-benchmark-runner/quickstart.md)
BENCHMARK_QUEUE_NAME=benchmark-jobs
BENCHMARK_WORKER_CONCURRENCY=2
BENCHMARK_MAX_INFLIGHT_PER_SESSION=1
BENCHMARK_JOB_TTL_SECONDS=86400
BENCHMARK_JOB_TIMEOUT_SECONDS=120
BENCHMARK_MAX_ATTEMPTS=2
BENCHMARK_BACKOFF_DELAY_MS=2000
BENCHMARK_PROGRESS_INTERVAL_MS=1000
BENCHMARK_PROGRESS_TTL_SECONDS=86400
BENCHMARK_K6_BINARY=k6
BENCHMARK_ALLOWED_RPS=100,500,1000,5000
BENCHMARK_ALLOWED_DURATION_SECONDS=10,30,60
# Defaults to http://localhost:$PORT when unset
# BENCHMARK_INTERNAL_BASE_URL=http://localhost:3001
BENCHMARK_INTERNAL_SECRET=benchmark-internal-dev

# SQL Execution Queue (async interactive SQL — see specs/013-sql-execution-queue/quickstart.md)
SQL_EXECUTION_QUEUE_NAME=sql-execution-jobs
# Align worker concurrency with playground pool capacity
SQL_EXECUTION_WORKER_CONCURRENCY=5
SQL_EXECUTION_JOB_TIMEOUT_SECONDS=60
SQL_EXECUTION_MAX_ATTEMPTS=2
SQL_EXECUTION_BACKOFF_MS=1000
SQL_EXECUTION_MAX_INFLIGHT_PER_SESSION=1
